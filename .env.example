# ---------------------------------------------------------------------------
# PixelForge AI — environment configuration
#
# Copy to .env.local and fill in. Never commit .env or .env.local.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public base URL. Used for Stripe redirects and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Image generation provider (required) ----------------------------------
# Which engine to use: "hosted" (Replicate), "invokeai" (self-hosted),
# or "local" (development only — see MODE C).
IMAGE_PROVIDER=hosted

# -- MODE A: hosted provider (Replicate) --
# Get a token at https://replicate.com/account/api-tokens
IMAGE_PROVIDER_API_KEY=
# Optional: pin different model versions.
# HOSTED_SDXL_VERSION=
# HOSTED_ESRGAN_VERSION=
# HOSTED_TIMEOUT_MS=180000

# -- MODE C: development preview (no API key, no GPU) --
# IMAGE_PROVIDER=local generates watermarked placeholder imagery so the whole
# pipeline — jobs, credits, storage, compositing, verification, refunds — can
# be exercised without a provider. It produces NO real imagery and refuses to
# run when NODE_ENV=production.
# DEV_PROVIDER_LATENCY_MS=350        # simulate engine latency
# DEV_PROVIDER_FAIL_RATE=0           # 0..1, to exercise the refund path
# ALLOW_DEV_PROVIDER_IN_PRODUCTION=  # leave unset; only for self-host smoke tests

# -- MODE B: self-hosted InvokeAI --
# Base URL of your running InvokeAI server (no trailing slash).
INVOKEAI_BASE_URL=http://127.0.0.1:9090
# Only needed if your InvokeAI instance requires authentication.
INVOKEAI_API_KEY=
# Optional: pin a specific installed model by key or name. Must be SDXL.
# INVOKEAI_MODEL_KEY=
# INVOKEAI_QUEUE_ID=default
# INVOKEAI_SCHEDULER=euler
# INVOKEAI_TIMEOUT_MS=180000

# Product Studio on InvokeAI uses Grounded-SAM for background removal.
# Both models download on first use.
# INVOKEAI_SEGMENT_PROMPT=the main product object
# INVOKEAI_DINO_MODEL=grounding-dino-base

# -- Background removal (Product Studio) --
# Run by owner/name rather than a pinned version, so no hash to maintain.
# HOSTED_REMOVE_BG_MODEL=851-labs/background-remover

# --- Stripe (required for paid plans) --------------------------------------
# Use test-mode keys (sk_test_...) while developing.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=

# One recurring price per paid tier. The plan is resolved from the price the
# customer is actually billed, so these must match your Stripe products.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_AGENCY=

# --- Plan limits -----------------------------------------------------------
FREE_MONTHLY_CREDITS=30
STARTER_MONTHLY_CREDITS=600
GROWTH_MONTHLY_CREDITS=2500
AGENCY_MONTHLY_CREDITS=10000

# Display prices only — Stripe owns the amount actually charged.
STARTER_PRICE_CENTS=4900
GROWTH_PRICE_CENTS=14900
AGENCY_PRICE_CENTS=49900

MAX_FREE_RESOLUTION=768
MAX_STARTER_RESOLUTION=1536
MAX_GROWTH_RESOLUTION=2048
MAX_AGENCY_RESOLUTION=2048

FREE_MAX_IMAGES_PER_REQUEST=2
STARTER_MAX_IMAGES_PER_REQUEST=4
GROWTH_MAX_IMAGES_PER_REQUEST=8
AGENCY_MAX_IMAGES_PER_REQUEST=8

STARTER_MAX_BRAND_KITS=1
GROWTH_MAX_BRAND_KITS=5
AGENCY_MAX_BRAND_KITS=50

STARTER_MAX_BATCH_ROWS=25
GROWTH_MAX_BATCH_ROWS=200
AGENCY_MAX_BATCH_ROWS=1000

AGENCY_MAX_CLIENTS=25

# --- Credit costs ----------------------------------------------------------
TEXT_TO_IMAGE_CREDIT_COST=1
IMAGE_TO_IMAGE_CREDIT_COST=2
PRODUCT_SCENE_CREDIT_COST=5
UPSCALE_2X_CREDIT_COST=3
UPSCALE_4X_CREDIT_COST=6

# How many batch rows run concurrently against the provider.
BATCH_CONCURRENCY=2

# --- Uploads and storage ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
# Lifetime of signed image URLs, in seconds.
SIGNED_URL_TTL_SECONDS=3600

# --- Safety ----------------------------------------------------------------
# Set to "false" to disable the prompt screening layer (self-hosted use only).
SAFETY_ENABLED=true
MAX_PROMPT_LENGTH=2000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_GENERATIONS_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_MINUTE=20

# --- Background jobs -------------------------------------------------------
# Shared secret protecting POST /api/jobs/sweep. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Marketing page --------------------------------------------------------
# The images in /public/showcase are licensed stock placeholders, NOT output
# from this app. While this is anything other than "false", the landing page
# shows a "Sample imagery" disclosure. Replace the files with your own real
# generations, then set this to false.
NEXT_PUBLIC_SHOWCASE_PLACEHOLDER=true

# Testimonials in config/testimonials.ts marked `placeholder: true` never render
# unless this is "true". Only ever set it locally, while designing — shipping a
# fabricated testimonial is illegal in the US, UK and EU.
NEXT_PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=false
