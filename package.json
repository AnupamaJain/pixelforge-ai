{
  "name": "pixelforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "test": "tsx --conditions=react-server scripts/verify-logic.ts && tsx --conditions=react-server scripts/verify-composite.ts && tsx --conditions=react-server scripts/verify-claims.ts && tsx --conditions=react-server scripts/verify-pipeline.ts",
    "test:composite": "tsx --conditions=react-server scripts/verify-composite.ts",
    "video:studio": "remotion studio video/index.ts",
    "video:hero": "remotion render video/index.ts HeroDemo out/pixelforge-hero.mp4",
    "video:social": "remotion render video/index.ts SocialVertical out/pixelforge-social-vertical.mp4",
    "video:square": "remotion render video/index.ts SocialSquare out/pixelforge-social-square.mp4",
    "video:all": "npm run video:hero && npm run video:social && npm run video:square && npm run video:comparison && npm run video:bumper && npm run video:bumper-vertical",
    "video:comparison": "remotion render video/index.ts Comparison out/pixelforge-comparison.mp4",
    "video:bumper": "remotion render video/index.ts Bumper out/pixelforge-bumper.mp4",
    "video:bumper-vertical": "remotion render video/index.ts BumperVertical out/pixelforge-bumper-vertical.mp4",
    "test:claims": "tsx --conditions=react-server scripts/verify-claims.ts",
    "test:pipeline": "tsx --conditions=react-server scripts/verify-pipeline.ts",
    "ads:preview": "cd ads && npx hyperframes preview",
    "ads:cost-shock": "cd ads && npx hyperframes render -c compositions/cost-shock.html -o renders/viral-cost-shock.mp4 --fps 30",
    "ads:pov-fail": "cd ads && npx hyperframes render -c compositions/pov-fail.html -o renders/viral-pov-fail.mp4 --fps 30",
    "ads:three-second": "cd ads && npx hyperframes render -c compositions/three-second-test.html -o renders/viral-three-second-test.mp4 --fps 30",
    "ads:all": "npm run ads:cost-shock && npm run ads:pov-fail && npm run ads:three-second"
  },
  "dependencies": {
    "@stripe/stripe-js": "^5.5.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-config-next": "^16.3.5",
    "lucide-react": "^0.474.0",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.525",
    "@remotion/cli": "^4.0.525",
    "@remotion/renderer": "^4.0.525",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "hyperframes": "^0.8.41",
    "postcss": "^8.5.28",
    "remotion": "^4.0.525",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
